CHFILE/INPUT
$$ =====================================================================
$$ OpenCMM - Helmel Checkmaster 1112-102 Characterization File (DMIS 5.3)
$$ =====================================================================

CHFIL1
(*-------------------------------------------------------------*)
(* DMIS 5.3 INPUT Grammar Subset supported by OpenCMM          *)
(*-------------------------------------------------------------*)
$$ HOW TO FILL OUT: This section defines the EBNF grammar subset 
$$ accepted by your OpenCMM interpreter. 
$$ - (* FULL *): Statement is fully implemented.
$$ - (* PART *): Only specific sub-formats or arguments are supported.
$$ - (* EXTENSION *): Custom non-standard extensions (e.g., QIF / REFID).
$$ Leave these grammar production rules as-is unless you extend OpenCMM's 
$$ parser to support additional DMIS 5.3 clauses.
(*-------------------------------------------------------------*)
inputFile = dmisFirstStatement , [dmisStatementList] , endfilStm ;
dmisFirstStatement = dmismnStm ;

dmisStatement = 
  aclratStm     (* FULL *)
  | assignStm   (* FULL *)
  | boundStm    (* FULL *)
  | calibStm    (* FULL *)
  | clearStm    (* FULL *)
  | constStm    (* PART *)
  | datdefStm   (* FULL *)
  | datsetStm   (* FULL *)
  | declStm     (* FULL *)
  | displyStm   (* FULL *)
  | dmisStm     (* FULL *)
  | endmesStm   (* FULL *)
  | endfilStm   (* FULL *)
  | evalStm     (* FULL *)
  | featStm     (* PART *)
  | fedratStm   (* FULL *)
  | filnamStm   (* FULL *)
  | gotoStm     (* FULL *)
  | ifStm       (* FULL *)
  | measStm     (* FULL *)
  | modeStm     (* FULL *)
  | outputStm   (* FULL *)
  | ptmeasStm   (* FULL *)
  | refidStm    (* EXTENSION - DMIS 5.3 QPId / REFID *)
  | rotateStm   (* FULL *)
  | saveStm     (* FULL *)
  | snsdefStm   (* PART *)
  | snslctStm   (* FULL *)
  | tecompStm   (* FULL *)
  | textStm     (* FULL *)
  | tolStm      (* PART *)
  | transStm    (* FULL *)
  | unitsStm    (* FULL *)
  | wkplanStm   (* FULL *)
  ;
ENDCH1

CHFIL2
$$ =====================================================================
$$ Machine-dependent parameters for OpenCMM & Helmel Checkmaster Hardware
$$ =====================================================================
$$ HOW TO FILL OUT: Configure this section to match your physical CMM 
$$ controller, encoder interfaces (RP2350 / Renishaw RGH22), and algorithms.

$$ ALGDEF: Defines the mathematical fitting algorithms supported by OpenCMM 
$$ for calculating features (circles, planes, cylinders) from measured points.
ALGDEF/CODE,INTGR
  1, 'Least Squares (LSTSQR)'
  2, 'Min-Max (MINMAX)'
  3, 'Maximum Inscribed (MAXINS)'
  4, 'Minimum Circumscribed (MINCIR)'
ENDAT

$$ ERROR: Maps machine and communication error codes returned by your 
$$ Pico 2 USB firmware or probe trigger logic to standard DMIS error handling.
ERROR/CODE,INTGR
  101, 'ILLEGALTOUCH: Unexpected or unintended probe trigger'
  102, 'NOTOUCH: Probe failed to trigger within search distance'
  103, 'ENCODER_COMM_ERROR: Pico 2 serial communications lost'
ENDAT

$$ FILDEF: Defines signal or profile filters available during measurement.
FILDEF/CODE,INTGR
  1, 'DEFAULT_FILTER'
ENDAT
ENDCH2

CHFIL3
$$ =====================================================================
$$ User-defined extensions and QIF 2.1 interoperability metadata
$$ =====================================================================
$$ HOW TO FILL OUT: Set interoperability flags for QIF export/import 
$$ and configure parser limits (such as max identifier length).
QIF_SUPPORT = TRUE
QPID_SUPPORT = TRUE
MAX_IDENTIFIER_LENGTH = 64
ENDCH3

ENDCHF


CHFILE/OUTPUT
$$ =====================================================================
$$ OpenCMM Output Characterization File
$$ =====================================================================
CHFIL1
(*-------------------------------------------------------------*)
(* DMIS 5.3 OUTPUT Grammar Subset generated by OpenCMM         *)
(*-------------------------------------------------------------*)
$$ HOW TO FILL OUT: Defines the grammar structure for inspection reports 
$$ and result files generated by OpenCMM after part measurement.
(*-------------------------------------------------------------*)
outputFile = dmisProg ;
dmisProg = filnamStm , [dmisOutputList] , endfilStm ;
dmisOutputList = [dmisOutputList] , dmisOutputStatement ;
dmisOutputStatement = 
  faFeatureStatement
  | taToleranceStatement
  | textResStatement
  ;
ENDCH1
ENDCHF